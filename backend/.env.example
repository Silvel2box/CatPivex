# Copy to backend/.env (same folder) and fill in. Never commit the real .env.

# SQLite file path (relative to backend/)
CATPIVEX_DB_PATH=catpivex.db

# Origins allowed by CORS (comma separated)
CATPIVEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phase 5 — alerts (optional; leave empty to disable a channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_CHANNEL_TOKEN=
LINE_USER_ID=
